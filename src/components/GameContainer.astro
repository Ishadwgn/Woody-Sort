---
export interface Props {
  initialLevel?: number;
  isEmbed?: boolean;
}

const { initialLevel = 1, isEmbed = false } = Astro.props;
---

<div class={`game-viewport ${isEmbed ? 'is-embedded' : ''}`} id="woody-game-root" data-initial-level={initialLevel}>
  <!-- Top HUD Bar -->
  <div class="game-top-bar">
    <div class="level-indicator">
      <div class="level-title-wrap">
        <span class="level-title" id="hud-level-title">Level 1</span>
        <button id="btn-open-level-select" class="btn-level-picker" title="Select Level">
          <span>📑 Levels</span>
        </button>
      </div>
      <span class="level-subtitle" id="hud-difficulty-badge">Gentle Forest • Easy</span>
    </div>

    <div class="stats-pill-group">
      <!-- Move counter -->
      <div class="stat-pill">
        <span class="stat-icon">🔄</span>
        <span>Moves: <strong id="hud-moves-count">0</strong></span>
      </div>

      <!-- Timer -->
      <div class="stat-pill">
        <span class="stat-icon">⏱️</span>
        <span id="hud-timer">00:00</span>
      </div>

      <!-- Par / Target moves -->
      <div class="stat-pill stat-pill-gold">
        <span class="stat-icon">⭐</span>
        <span>Par: <strong id="hud-par-moves">4</strong></span>
      </div>
    </div>
  </div>

  <!-- Wooden Game Shelf Container -->
  <div class="game-board-container" id="game-board-container">
    <!-- START / PLAY NOW COVER OVERLAY -->
    <div id="game-start-cover" class="game-start-cover">
      <div class="start-cover-content">
        <div class="start-logo-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="68" height="68" viewBox="0 0 64 64">
            <circle cx="32" cy="32" r="30" fill="#2c1a0e" stroke="#d97724" stroke-width="2.5" />
            <rect x="18" y="10" width="28" height="6" rx="3" fill="#d97724" stroke="#f59e0b" stroke-width="1.5" />
            <path d="M 22 16 L 22 46 C 22 52 42 52 42 46 L 42 16 Z" fill="rgba(245, 158, 11, 0.25)" stroke="#9c5c2d" stroke-width="3" />
            <circle cx="32" cy="46" r="7" fill="#16a34a" />
            <circle cx="32" cy="32" r="7" fill="#eab308" />
            <circle cx="32" cy="18" r="7" fill="#e11d48" />
          </svg>
        </div>
        <h2 class="start-game-title">Woody Sort Game</h2>
        <p class="start-game-tagline">Relaxing Zen Ball Sorting Puzzle</p>

        <!-- Prominent Play Now Button -->
        <button id="btn-play-now-trigger" class="btn-play-now animate-glow">
          <span class="play-icon-triangle">▶</span>
          <span class="play-text">PLAY NOW</span>
        </button>

        <div class="start-sub-info">
          <span>🌿 100% Free Online</span>
          <span>•</span>
          <span>50+ Levels</span>
          <span>•</span>
          <span>Sound & Boosters</span>
        </div>
      </div>
    </div>

    <!-- Active Tubes and Balls rendered dynamically here -->
    <div id="woody-board-grid" class="woody-board-grid">
      <!-- Generated by WoodySortEngine -->
    </div>
  </div>

  <!-- Booster Action Controls Bar -->
  <div class="game-controls-bar">
    <!-- Booster: Undo -->
    <button id="btn-booster-undo" class="booster-btn" title="Undo previous move (Keyboard: U)">
      <span class="booster-icon">↩️</span>
      <span class="booster-label">Undo</span>
    </button>

    <!-- Booster: Add +1 Tube -->
    <button id="btn-booster-add-tube" class="booster-btn" title="Add extra empty wooden tube for difficult layouts">
      <span class="booster-icon">🧪</span>
      <span class="booster-label">+1 Tube</span>
      <span class="booster-badge" id="hud-extra-tubes-left">2 Left</span>
    </button>

    <!-- Booster: Smart AI Hint -->
    <button id="btn-booster-hint" class="booster-btn" title="Get optimal next move from BFS Solver (Keyboard: H)">
      <span class="booster-icon">💡</span>
      <span class="booster-label">Hint</span>
    </button>

    <!-- Booster: Restart -->
    <button id="btn-booster-restart" class="booster-btn" title="Restart current level (Keyboard: R)">
      <span class="booster-icon">🔁</span>
      <span class="booster-label">Restart</span>
    </button>

    <!-- Theme / Customizer button -->
    <button id="btn-open-customizer" class="booster-btn" title="Customize Wooden Tubes & Ball Skins">
      <span class="booster-icon">🎨</span>
      <span class="booster-label">Skins</span>
    </button>
  </div>

  <!-- VICTORY MODAL -->
  <div id="victory-modal" class="game-modal-overlay">
    <div class="game-modal">
      <div class="win-header">
        <div class="win-icon-burst">🏆</div>
        <h2 class="win-title">Level Completed!</h2>
        <p class="win-subtitle" id="win-subtitle-msg">Splendid woodcraft sorting!</p>
      </div>

      <!-- Star rating animation -->
      <div class="win-stars-display" id="win-stars-group">
        <span class="win-star star-1">⭐</span>
        <span class="win-star star-2">⭐</span>
        <span class="win-star star-3">⭐</span>
      </div>

      <!-- Score & stats recap -->
      <div class="win-stats-grid">
        <div class="win-stat-card">
          <span class="win-stat-label">Moves Taken</span>
          <span class="win-stat-val" id="win-moves-val">6</span>
        </div>
        <div class="win-stat-card">
          <span class="win-stat-label">Coins Earned</span>
          <span class="win-stat-val text-gold" id="win-coins-val">+75 🪙</span>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="win-modal-actions">
        <button id="btn-win-replay" class="btn btn-secondary">
          <span>🔁 Replay</span>
        </button>
        <button id="btn-win-next" class="btn btn-primary">
          <span>Next Level ➔</span>
        </button>
      </div>
    </div>
  </div>

  <!-- LEVEL SELECTOR MODAL -->
  <div id="level-select-modal" class="game-modal-overlay">
    <div class="game-modal level-select-modal-box">
      <div class="modal-top">
        <h2 class="modal-title">Select Level</h2>
        <button id="btn-close-level-select" class="btn-icon modal-close-btn">✕</button>
      </div>
      <p class="modal-subtitle">Progress through forest realms and unlock mystery hidden chambers!</p>
      
      <!-- Levels Tabs -->
      <div class="level-tabs">
        <button class="level-tab active" data-tab="campaign">🌲 Forest Campaign (1-50)</button>
        <button class="level-tab" data-tab="secret">🗝️ Hidden Chambers</button>
      </div>

      <!-- Levels Grid -->
      <div id="level-picker-grid" class="level-picker-grid">
        <!-- Rendered dynamically -->
      </div>
    </div>
  </div>

  <!-- SKINS / THEMES MODAL -->
  <div id="customizer-modal" class="game-modal-overlay">
    <div class="game-modal">
      <div class="modal-top">
        <h2 class="modal-title">Wood Workshop & Skins</h2>
        <button id="btn-close-customizer" class="btn-icon modal-close-btn">✕</button>
      </div>
      <p class="modal-subtitle">Choose your favorite artisan wooden tubes and ball spheres.</p>

      <div class="customizer-section">
        <h4 class="custom-sec-title">Wooden Tube Style</h4>
        <div class="theme-options-grid">
          <button class="theme-option active" data-theme="oak">
            <span class="theme-preview oak-preview"></span>
            <span class="theme-name">Classic Oak</span>
          </button>
          <button class="theme-option" data-theme="walnut">
            <span class="theme-preview walnut-preview"></span>
            <span class="theme-name">Dark Walnut</span>
          </button>
          <button class="theme-option" data-theme="bamboo">
            <span class="theme-preview bamboo-preview"></span>
            <span class="theme-name">Zen Bamboo</span>
          </button>
          <button class="theme-option" data-theme="mahogany">
            <span class="theme-preview mahogany-preview"></span>
            <span class="theme-name">Mahogany</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .btn-level-picker {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--wood-gold);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    margin-left: 8px;
    cursor: pointer;
  }
  .btn-level-picker:hover {
    background: rgba(245, 158, 11, 0.3);
    border-color: var(--wood-gold);
  }

  .level-title-wrap {
    display: flex;
    align-items: center;
  }

  /* START COVER OVERLAY */
  .game-start-cover {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: linear-gradient(180deg, rgba(32, 19, 9, 0.96) 0%, rgba(20, 11, 5, 0.98) 100%);
    backdrop-filter: blur(12px);
    border-radius: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .game-start-cover.started {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96);
  }

  .start-cover-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    max-width: 440px;
  }

  .start-logo-icon {
    filter: drop-shadow(0 0 24px rgba(245, 158, 11, 0.6));
    animation: floatGentle 3s infinite ease-in-out;
  }

  .start-game-title {
    font-size: 2.3rem;
    font-weight: 900;
    color: var(--wood-gold);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: 4px;
    text-shadow: 0 4px 14px rgba(0,0,0,0.6);
  }

  .start-game-tagline {
    font-size: 1.02rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  /* Play Now Big Button */
  .btn-play-now {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97724 50%, #b45309 100%);
    color: #1a120b;
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    padding: 16px 44px;
    border-radius: 9999px;
    border: 3px solid #fef3c7;
    box-shadow: 
      0 8px 25px rgba(245, 158, 11, 0.6),
      inset 0 2px 4px rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    user-select: none;
  }

  .btn-play-now:hover {
    transform: scale(1.08) translateY(-3px);
    box-shadow: 
      0 12px 35px rgba(245, 158, 11, 0.8),
      inset 0 2px 6px rgba(255, 255, 255, 0.8);
    filter: brightness(1.08);
  }

  .btn-play-now:active {
    transform: scale(0.98) translateY(1px);
  }

  .play-icon-triangle {
    font-size: 1.5rem;
  }

  .start-sub-info {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 10px;
  }

  /* Victory Modal Internal Styles */
  .win-icon-burst {
    font-size: 3rem;
    margin-bottom: 8px;
    animation: bounceIcon 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes bounceIcon {
    0% { transform: scale(0); }
    60% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .win-title {
    font-size: 1.8rem;
    color: var(--wood-gold);
    margin-bottom: 4px;
  }

  .win-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .win-stars-display {
    display: flex;
    justify-content: center;
    gap: 12px;
    font-size: 2.5rem;
    margin-bottom: 24px;
  }

  .win-star {
    opacity: 0.2;
    transform: scale(0.6);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .win-star.active {
    opacity: 1;
    transform: scale(1.15);
    filter: drop-shadow(0 0 12px #f59e0b);
  }

  .win-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }

  .win-stat-card {
    background: rgba(26, 18, 11, 0.8);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .win-stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 700;
  }

  .win-stat-val {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .win-modal-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .win-modal-actions .btn {
    flex: 1;
  }

  /* Level Picker Modal Box */
  .level-select-modal-box {
    max-width: 620px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
  }

  .modal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .modal-title {
    font-size: 1.4rem;
    color: var(--wood-gold);
  }

  .modal-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .level-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(245, 158, 11, 0.2);
    padding-bottom: 8px;
  }

  .level-tab {
    background: transparent;
    border: 1px solid rgba(245, 158, 11, 0.2);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .level-tab.active {
    background: var(--wood-gold);
    color: #1a120b;
    border-color: var(--wood-gold);
  }

  .level-picker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(68px, 1fr));
    gap: 10px;
    overflow-y: auto;
    max-height: 380px;
    padding-right: 6px;
  }

  /* Level button in picker */
  :global(.level-node-btn) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(44, 26, 14, 0.8);
    border: 2px solid rgba(245, 158, 11, 0.3);
    border-radius: var(--radius-md);
    padding: 10px 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 64px;
  }

  :global(.level-node-btn:hover:not(.locked)) {
    background: var(--wood-medium);
    border-color: var(--wood-gold);
    transform: translateY(-2px);
  }

  :global(.level-node-btn.active-current) {
    border-color: var(--wood-gold);
    box-shadow: 0 0 14px rgba(245, 158, 11, 0.6);
    background: rgba(120, 68, 33, 0.9);
  }

  :global(.level-node-btn.locked) {
    opacity: 0.45;
    cursor: not-allowed;
    filter: grayscale(0.8);
  }

  :global(.level-node-num) {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  :global(.level-node-stars) {
    font-size: 0.65rem;
    color: #f59e0b;
    margin-top: 2px;
  }

  /* Themes grid */
  .theme-options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 14px;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(44, 26, 14, 0.8);
    border: 2px solid rgba(245, 158, 11, 0.3);
    padding: 12px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    cursor: pointer;
  }

  .theme-option.active {
    border-color: var(--wood-gold);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    background: rgba(120, 68, 33, 0.8);
  }

  .theme-preview {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: inline-block;
  }

  .oak-preview { background: linear-gradient(135deg, #784421, #4a2d18); }
  .walnut-preview { background: linear-gradient(135deg, #3d2314, #1a120b); }
  .bamboo-preview { background: linear-gradient(135deg, #65a30d, #365314); }
  .mahogany-preview { background: linear-gradient(135deg, #991b1b, #450a0a); }
</style>

<script>
  import { WoodySortEngine } from '../scripts/game/engine';
  import { sound } from '../scripts/game/audio';
  import { loadProgress, saveProgress } from '../scripts/game/storage';
  import { CURATED_LEVELS, HIDDEN_LEVELS } from '../scripts/game/levels';

  let engine: WoodySortEngine | null = null;
  let activeTab = 'campaign';
  let hasStarted = false;

  function formatTimer(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function initGame() {
    const rootEl = document.getElementById('woody-game-root');
    const boardEl = document.getElementById('woody-board-grid');
    const startCover = document.getElementById('game-start-cover');
    const btnPlayNow = document.getElementById('btn-play-now-trigger');
    if (!rootEl || !boardEl) return;

    const initialLevel = parseInt(rootEl.dataset.initialLevel || '1', 10);
    engine = new WoodySortEngine(boardEl);

    // Bind UI HUD elements
    const hudTitle = document.getElementById('hud-level-title');
    const hudDiff = document.getElementById('hud-difficulty-badge');
    const hudMoves = document.getElementById('hud-moves-count');
    const hudTimer = document.getElementById('hud-timer');
    const hudPar = document.getElementById('hud-par-moves');
    const btnUndo = document.getElementById('btn-booster-undo') as HTMLButtonElement;
    const btnAddTube = document.getElementById('btn-booster-add-tube') as HTMLButtonElement;
    const hudExtraLeft = document.getElementById('hud-extra-tubes-left');

    engine.setCallbacks(
      // On state change
      (e) => {
        const stats = e.getStats();
        const config = e.getLevelConfig();
        const levelId = e.getLevelId();

        if (hudTitle) {
          hudTitle.textContent = config.isSecret ? `Hidden Chamber #${levelId - 100}` : `Level ${levelId}`;
        }
        if (hudDiff) {
          hudDiff.textContent = `${config.name || 'Realm'} • ${config.difficulty}`;
        }
        if (hudMoves) {
          hudMoves.textContent = `${stats.moves}`;
        }
        if (hudTimer) {
          hudTimer.textContent = formatTimer(stats.elapsedSeconds);
        }
        if (hudPar) {
          hudPar.textContent = `${config.parMoves || 20}`;
        }
        if (btnUndo) {
          btnUndo.disabled = !e.canUndo();
        }
        if (btnAddTube) {
          btnAddTube.disabled = !e.canAddTube();
        }
        if (hudExtraLeft) {
          hudExtraLeft.textContent = `${2 - stats.extraTubesUsed} Left`;
        }
      },
      // On Win
      (stars, moves, coinsEarned) => {
        showVictoryModal(stars, moves, coinsEarned);
      }
    );

    // Initial render of board behind cover
    engine.init(initialLevel);

    // Play Now button click trigger
    btnPlayNow?.addEventListener('click', () => {
      hasStarted = true;
      startCover?.classList.add('started');
      sound.playWoodKnock(1.1);
      // Restart timer / init fresh on user gesture
      engine?.init(initialLevel);
    });

    // Booster buttons
    btnUndo?.addEventListener('click', () => engine?.undo());
    btnAddTube?.addEventListener('click', () => engine?.addExtraTube());
    document.getElementById('btn-booster-hint')?.addEventListener('click', () => engine?.hint());
    document.getElementById('btn-booster-restart')?.addEventListener('click', () => engine?.restart());

    // Keyboard controls
    window.addEventListener('keydown', (e) => {
      if (!engine) return;
      if (!hasStarted) {
        if (e.key === ' ' || e.key === 'Enter') {
          hasStarted = true;
          startCover?.classList.add('started');
          sound.playWoodKnock(1.1);
          engine.init(initialLevel);
        }
        return;
      }
      if (e.key === 'u' || e.key === 'U') engine.undo();
      if (e.key === 'h' || e.key === 'H') engine.hint();
      if (e.key === 'r' || e.key === 'R') engine.restart();
      const num = parseInt(e.key, 10);
      if (!isNaN(num) && num >= 1 && num <= 9) {
        engine.handleTubeClick(num - 1);
      }
    });

    // Modal triggers
    initModals();
  }

  function showVictoryModal(stars: number, moves: number, coinsEarned: number) {
    const modal = document.getElementById('victory-modal');
    if (!modal) return;

    const movesVal = document.getElementById('win-moves-val');
    const coinsVal = document.getElementById('win-coins-val');
    const starsGroup = document.getElementById('win-stars-group');

    if (movesVal) movesVal.textContent = `${moves}`;
    if (coinsVal) coinsVal.textContent = `+${coinsEarned} 🪙`;

    if (starsGroup) {
      const starEls = starsGroup.querySelectorAll('.win-star');
      starEls.forEach((el, idx) => {
        if (idx < stars) {
          setTimeout(() => el.classList.add('active'), (idx + 1) * 200);
        } else {
          el.classList.remove('active');
        }
      });
    }

    // Refresh header coins badge
    const progress = loadProgress();
    const headerCoins = document.getElementById('header-coins-count');
    if (headerCoins) headerCoins.textContent = `${progress.coins}`;

    modal.classList.add('active');
  }

  function initModals() {
    const victoryModal = document.getElementById('victory-modal');
    const levelModal = document.getElementById('level-select-modal');
    const customizerModal = document.getElementById('customizer-modal');
    const startCover = document.getElementById('game-start-cover');

    // Victory actions
    document.getElementById('btn-win-replay')?.addEventListener('click', () => {
      victoryModal?.classList.remove('active');
      engine?.restart();
    });

    document.getElementById('btn-win-next')?.addEventListener('click', () => {
      victoryModal?.classList.remove('active');
      if (engine) {
        const cur = engine.getLevelId();
        const next = cur >= 100 ? 1 : cur + 1;
        engine.init(next);
      }
    });

    // Level Picker
    document.getElementById('btn-open-level-select')?.addEventListener('click', () => {
      renderLevelPicker();
      levelModal?.classList.add('active');
    });

    document.getElementById('btn-close-level-select')?.addEventListener('click', () => {
      levelModal?.classList.remove('active');
    });

    // Tabs inside Level Picker
    document.querySelectorAll('.level-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.level-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        activeTab = target.dataset.tab || 'campaign';
        renderLevelPicker();
      });
    });

    // Customizer Modal
    document.getElementById('btn-open-customizer')?.addEventListener('click', () => {
      customizerModal?.classList.add('active');
    });

    document.getElementById('btn-close-customizer')?.addEventListener('click', () => {
      customizerModal?.classList.remove('active');
    });

    // Theme select options
    document.querySelectorAll('.theme-option').forEach(opt => {
      opt.addEventListener('click', (e) => {
        document.querySelectorAll('.theme-option').forEach(o => o.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        const theme = target.dataset.theme as any;
        const p = loadProgress();
        p.selectedTheme = theme;
        saveProgress(p);
        engine?.render();
      });
    });
  }

  function renderLevelPicker() {
    const grid = document.getElementById('level-picker-grid');
    const startCover = document.getElementById('game-start-cover');
    if (!grid) return;

    grid.innerHTML = '';
    const progress = loadProgress();
    const curLevelId = engine?.getLevelId() || 1;

    if (activeTab === 'campaign') {
      for (let i = 1; i <= 50; i++) {
        const isUnlocked = i <= progress.unlockedLevel;
        const stars = progress.stars[i] || 0;
        const isCurrent = i === curLevelId;

        const btn = document.createElement('button');
        btn.className = `level-node-btn ${isCurrent ? 'active-current' : ''} ${!isUnlocked ? 'locked' : ''}`;
        
        let starStr = '☆☆☆';
        if (stars === 3) starStr = '⭐⭐⭐';
        else if (stars === 2) starStr = '⭐⭐☆';
        else if (stars === 1) starStr = '⭐☆☆';

        btn.innerHTML = `
          <span class="level-node-num">${isUnlocked ? i : '🔒'}</span>
          <span class="level-node-stars">${isUnlocked ? starStr : 'Locked'}</span>
        `;

        if (isUnlocked) {
          btn.addEventListener('click', () => {
            hasStarted = true;
            startCover?.classList.add('started');
            engine?.init(i);
            document.getElementById('level-select-modal')?.classList.remove('active');
          });
        }
        grid.appendChild(btn);
      }
    } else {
      // Secret / Hidden Levels
      HIDDEN_LEVELS.forEach(lvl => {
        const isUnlocked = progress.unlockedSecrets.includes(lvl.id);
        const stars = progress.stars[lvl.id] || 0;
        const isCurrent = lvl.id === curLevelId;

        const btn = document.createElement('button');
        btn.className = `level-node-btn ${isCurrent ? 'active-current' : ''} ${!isUnlocked ? 'locked' : ''}`;

        btn.innerHTML = `
          <span class="level-node-num">${isUnlocked ? `🗝️ ${lvl.id - 100}` : '🔒'}</span>
          <span class="level-node-stars">${isUnlocked ? 'Hidden Master' : '10★ to Unlock'}</span>
        `;

        if (isUnlocked) {
          btn.addEventListener('click', () => {
            hasStarted = true;
            startCover?.classList.add('started');
            engine?.init(lvl.id);
            document.getElementById('level-select-modal')?.classList.remove('active');
          });
        }
        grid.appendChild(btn);
      });
    }
  }

  // Init on DOM ready
  if (typeof document !== 'undefined') {
    initGame();
  }
</script>
