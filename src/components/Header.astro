---
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" title="Woody Sort Game - Home">
      <div class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 64 64">
          <circle cx="32" cy="32" r="30" fill="#2c1a0e" stroke="#d97724" stroke-width="2" />
          <rect x="18" y="10" width="28" height="6" rx="3" fill="#d97724" stroke="#f59e0b" stroke-width="1.5" />
          <path d="M 22 16 L 22 46 C 22 52 42 52 42 46 L 42 16 Z" fill="rgba(245, 158, 11, 0.2)" stroke="#9c5c2d" stroke-width="3" />
          <circle cx="32" cy="46" r="7" fill="#16a34a" />
          <circle cx="32" cy="32" r="7" fill="#eab308" />
          <circle cx="32" cy="18" r="7" fill="#e11d48" />
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-title">Woody Sort<span class="logo-accent">.</span></span>
        <span class="logo-subtitle">Color Sort Puzzle</span>
      </div>
    </a>

    <!-- Navigation Menu (Desktop) -->
    <nav class="nav-links">
      <a href="/" class="nav-item">Game</a>
      <a href="/how-to-play" class="nav-item">How to Play</a>
      <a href="/hidden-levels" class="nav-item">Hidden Levels</a>
      <a href="/faq" class="nav-item">FAQ</a>
    </nav>

    <!-- Header Actions (Sound toggle, Nature toggle, Coins, Mobile Menu) -->
    <div class="header-actions">
      <!-- Ambient Forest Sound Button -->
      <button id="header-ambient-btn" class="btn-icon" title="Toggle Forest Breeze & Birds Ambient Sound" aria-label="Toggle Forest Ambience">
        <span class="icon-ambient">🍃</span>
      </button>

      <!-- Sound FX Toggle -->
      <button id="header-sound-btn" class="btn-icon" title="Toggle Sound FX" aria-label="Toggle Sound FX">
        <span class="icon-sound">🔊</span>
      </button>

      <!-- Coins counter -->
      <div class="coins-badge" title="Woody Coins">
        <span class="coin-icon">🪙</span>
        <span id="header-coins-count">150</span>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-toggle" class="btn-icon mobile-toggle-btn" aria-label="Toggle Menu">
        <span>☰</span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer">
    <nav class="mobile-nav-links">
      <a href="/" class="mobile-nav-item">🎮 Play Woody Sort Game</a>
      <a href="/how-to-play" class="mobile-nav-item">📜 How to Play & Rules</a>
      <a href="/hidden-levels" class="mobile-nav-item">🗝️ Secret Hidden Levels</a>
      <a href="/faq" class="mobile-nav-item">❓ FAQ & Real Money Guide</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(26, 18, 11, 0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 20px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    user-select: none;
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 2px 8px rgba(245, 158, 11, 0.4));
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .logo-accent {
    color: var(--wood-gold);
  }

  .logo-subtitle {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wood-gold);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: auto;
    margin-right: 14px;
  }

  .nav-item {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: all 0.2s ease;
    padding: 6px 6px;
    border-bottom: 2px solid transparent;
    letter-spacing: 0.01em;
  }

  .nav-item:hover {
    color: var(--wood-gold);
    border-bottom-color: var(--wood-gold);
    transform: translateY(-1px);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .coins-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(44, 26, 14, 0.85);
    border: 1px solid rgba(245, 158, 11, 0.4);
    padding: 6px 12px;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--wood-gold);
  }

  .mobile-toggle-btn {
    display: none;
    font-size: 1.3rem;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    background: #201309;
    border-bottom: 2px solid rgba(245, 158, 11, 0.3);
    padding: 16px 20px 20px;
    animation: slideDown 0.25s ease-out;
  }

  .mobile-drawer.open {
    display: block;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-nav-item {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    padding: 10px 14px;
    background: rgba(44, 26, 14, 0.6);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(245, 158, 11, 0.2);
    transition: all 0.2s ease;
  }

  .mobile-nav-item:hover {
    background: var(--wood-medium);
    color: var(--wood-gold);
    border-color: var(--wood-gold);
  }

  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
    .mobile-toggle-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  import { sound } from '../scripts/game/audio';
  import { loadProgress, saveProgress } from '../scripts/game/storage';

  function initHeaderControls() {
    const progress = loadProgress();
    const soundBtn = document.getElementById('header-sound-btn');
    const ambientBtn = document.getElementById('header-ambient-btn');
    const coinsEl = document.getElementById('header-coins-count');
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileDrawer = document.getElementById('mobile-drawer');

    if (coinsEl) {
      coinsEl.textContent = `${progress.coins}`;
    }

    if (soundBtn) {
      sound.setSoundEnabled(progress.soundEnabled);
      const icon = soundBtn.querySelector('.icon-sound');
      if (icon) icon.textContent = progress.soundEnabled ? '🔊' : '🔇';

      soundBtn.addEventListener('click', () => {
        const cur = loadProgress();
        const next = !cur.soundEnabled;
        cur.soundEnabled = next;
        saveProgress(cur);
        sound.setSoundEnabled(next);
        if (icon) icon.textContent = next ? '🔊' : '🔇';
        if (next) sound.playWoodKnock();
      });
    }

    if (ambientBtn) {
      sound.setAmbientEnabled(progress.ambientEnabled);
      ambientBtn.style.opacity = progress.ambientEnabled ? '1' : '0.5';

      ambientBtn.addEventListener('click', () => {
        const cur = loadProgress();
        const next = !cur.ambientEnabled;
        cur.ambientEnabled = next;
        saveProgress(cur);
        sound.setAmbientEnabled(next);
        ambientBtn.style.opacity = next ? '1' : '0.5';
        if (next) sound.playWoodKnock();
      });
    }

    if (mobileToggle && mobileDrawer) {
      mobileToggle.addEventListener('click', () => {
        mobileDrawer.classList.toggle('open');
      });
    }
  }

  // Run on page load
  if (typeof document !== 'undefined') {
    initHeaderControls();
  }
</script>
